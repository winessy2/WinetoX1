-- базе финдер
local function findPlayerPlot()
    local plotsFolder = workspace:FindFirstChild("Plots")
    if not plotsFolder then
        warn("Папки plot и тд нэ нашлось поэтому итдите и перезаходите")
        return nil
    end

    for i = 1, 6 do
        local plot = plotsFolder:FindFirstChild("Plot" .. i)
        if plot and plot:FindFirstChild("Owner") and plot.Owner:IsA("StringValue") then
            if plot.Owner.Value == Player.Name then
                return plot
            end
        end
    end

    warn("нету вашего ника в плотах перезаходите либо я хз (если перезахд не помог в тг сообщениях пишите) " .. Player.Name)
    return nil
end


local function startNpcFollow()
    local plot = findPlayerPlot()
    if not plot then 
        return 
    end

    npcPart = plot:FindFirstChild("NPCZone")
    if not npcPart or not npcPart:IsA("BasePart") then 
        return 
    end

    npcOriginalCFrame = npcPart.CFrame

    task.wait(0.5)

    if npcFollowConnection then
        npcFollowConnection:Disconnect()
        npcFollowConnection = nil
    end


    npcFollowConnection = RunService.Heartbeat:Connect(function()
        if npcFollowEnabled and Character and Character:FindFirstChild("HumanoidRootPart") and npcPart then
            npcPart.CFrame = Character.HumanoidRootPart.CFrame
        end
    end)

end


local function stopNpcFollow()
    if npcFollowConnection then
        npcFollowConnection:Disconnect()
        npcFollowConnection = nil
    end

    if npcPart and npcOriginalCFrame then
        npcPart.CFrame = npcOriginalCFrame
    end
end


